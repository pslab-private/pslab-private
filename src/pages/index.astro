---
import { getTagName } from "@/i18n/locale";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const posts = getSortedPosts(await getCollection("posts"), locale);
const tags = getUniqueTags(posts);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    class="app-layout home-main"
    data-layout="index"
    data-home-path={homePath}
  >
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">
          <span class="status-dot" aria-hidden="true"></span> PHYSICS SIM LAB · NOTES
        </p>
        <h1 id="hero-title">{t.site.heroTitle}</h1>
        <p class="hero-description">
          {t.site.heroDescription}
        </p>
      </div>
      <div class="company-summary">
        <span class="eyebrow">DEVELOPMENT · EXPERIMENTS · IDEAS</span>
        <p>
          {t.site.companySummary}
        </p>
        <a class="text-link" href="https://pslab.ai/"
          >{t.site.companyWebsite} <span aria-hidden="true">↗</span></a
        >
      </div>
    </section>
    <div class="topic-bar">
      <span class="eyebrow">EXPLORE</span><a
        class="topic-all"
        href={getRelativeLocaleUrl(locale, "posts")}
        >{t.nav.posts} <span>{posts.length}</span></a
      >{
        tags
          .slice(0, 5)
          .map(({ tag, tagName }) => (
            <a href={getRelativeLocaleUrl(locale, `tags/${tag}`)}>
              {getTagName(tagName, locale)}
            </a>
          ))
      }
    </div>
    {
      posts.length > 0 && (
        <section class="home-section">
          <div class="section-heading">
            <div>
              <span class="eyebrow">NOTES</span>
              <h2>{t.nav.posts}</h2>
            </div>
          </div>
          <ul>
            {posts.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector<HTMLElement>("[data-home-path]");
    if (main?.dataset.homePath)
      sessionStorage.setItem("backUrl", main.dataset.homePath);
  });
</script>
