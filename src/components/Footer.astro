---
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
const { class: className, noMarginTop = false, ...attrs } = Astro.props;
const t = useTranslations(Astro.currentLocale ?? "ko");
---

<footer
  class:list={[
    "app-layout site-footer",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div>
    <a
      class="footer-brand brand-logo-frame"
      href="https://pslab.ai/"
      aria-label={`PHYSICS SiM Lab ${t.site.companyWebsite}`}
      ><img
        class="company-logo"
        src={getAssetPath("brand/pslab-logo.png")}
        alt="PHYSICS SiM Lab"
        width="160"
        height="36"
      /></a
    >
    <p>{t.site.footerDescription}</p>
  </div>
  <div class="footer-links">
    <a href="https://pslab.ai/">{t.site.companyWebsite} ↗</a>
    <a href="mailto:ask-psl@pslab.ai">{t.site.emailContact}</a>
    <span>© {new Date().getFullYear()} Physics Sim Lab, inc.</span>
  </div>
</footer>
