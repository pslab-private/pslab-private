---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { stripBase, stripLocale, getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import { localizePath } from "@/i18n/locale";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const path = stripLocale(stripBase(Astro.url.pathname), locale);
const links = [
  { path: "posts", label: t.nav.posts },
  { path: "tags", label: t.nav.tags },
  { path: "about", label: t.nav.about },
];
---

<a id="skip-to-content" href="#main-content" class="skip-link"
  >{t.a11y.skipToContent}</a
>
<header class="site-header app-layout">
  <a
    class="brand"
    href={getRelativeLocaleUrl(locale, "")}
    aria-label={`PSL Tech ${t.nav.home}`}
  >
    <span class="brand-logo-frame"
      ><img
        class="company-logo"
        src={getAssetPath("brand/pslab-logo.png")}
        alt="PHYSICS SiM Lab"
        width="184"
        height="42"
      /></span
    >
    <span class="brand-tech">TECH</span>
  </a>
  <nav aria-label={t.site.mainMenu}>
    {
      links.map(link => (
        <a
          href={getRelativeLocaleUrl(locale, link.path)}
          aria-current={path.startsWith(`/${link.path}`) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <span class="nav-divider" aria-hidden="true"></span>
    <span class="language-switch" role="group" aria-label={t.site.language}>
      <a
        href={localizePath(
          /\/404(?:\.html|\/)?$/.test(Astro.url.pathname)
            ? "/"
            : Astro.url.pathname,
          "ko"
        )}
        lang="ko"
        hreflang="ko"
        data-language="ko"
        data-astro-reload
        aria-current={locale === "ko" ? "true" : undefined}>한국어</a
      >
      <a
        href={localizePath(
          /\/404(?:\.html|\/)?$/.test(Astro.url.pathname)
            ? "/"
            : Astro.url.pathname,
          "en"
        )}
        lang="en"
        hreflang="en"
        data-language="en"
        data-astro-reload
        aria-current={locale === "en" ? "true" : undefined}>English</a
      >
    </span>
    <a
      href={getRelativeLocaleUrl(locale, "search")}
      class="icon-button"
      aria-label={t.nav.search}
      title={t.nav.search}><IconSearch /></a
    >
    <button
      id="theme-btn"
      class="icon-button"
      type="button"
      title={t.a11y.toggleTheme}
      aria-label={t.a11y.toggleTheme}
    >
      <IconMoon class="dark:hidden" /><IconSunHigh class="hidden dark:block" />
    </button>
  </nav>
</header>
