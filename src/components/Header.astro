---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import { stripBase } from "@/utils/withBase";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const path = stripBase(Astro.url.pathname);
const links = [
  { path: "posts", label: "글" },
  { path: "tags", label: "태그" },
  { path: "about", label: "소개" },
];
---

<a id="skip-to-content" href="#main-content" class="skip-link"
  >본문으로 바로가기</a
>
<header class="site-header app-layout">
  <a
    class="brand"
    href={getRelativeLocaleUrl(locale, "")}
    aria-label="PSL Tech 홈"
  >
    <span class="brand-mark" aria-hidden="true">p<span>.</span></span>
    <span>PSL<span class="brand-light"> Tech</span></span>
  </a>
  <nav aria-label="메인 메뉴">
    {
      links.map(link => (
        <a
          href={getRelativeLocaleUrl(locale, link.path)}
          aria-current={path.startsWith(`/${link.path}`) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <span class="nav-divider" aria-hidden="true"></span>
    <a
      href={getRelativeLocaleUrl(locale, "search")}
      class="icon-button"
      aria-label="글 검색"
      title="글 검색"><IconSearch /></a
    >
    <button
      id="theme-btn"
      class="icon-button"
      type="button"
      title="화면 테마 전환"
      aria-label="화면 테마 전환"
    >
      <IconMoon class="dark:hidden" /><IconSunHigh class="hidden dark:block" />
    </button>
  </nav>
</header>
