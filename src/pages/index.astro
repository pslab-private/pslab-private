---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import config from "@/config";
const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const featured = posts.find(post => post.data.featured);
const recent = posts.filter(post => post.id !== featured?.id);
const tags = getUniqueTags(posts);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    class="app-layout home-main"
    data-layout="index"
    data-home-path={homePath}
  >
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">
          <span class="status-dot" aria-hidden="true"></span> A PLACE FOR ENGINEERING
          NOTES
        </p>
        <h1 id="hero-title">작게 만들고,<br /><span>깊이 이해합니다.</span></h1>
        <p class="hero-description">
          코드 너머의 이유를 탐구합니다.<br />직접 부딪히며 배운 기술과 문제
          해결의 과정을 기록합니다.
        </p>
        <a class="primary-link" href={getRelativeLocaleUrl(locale, "posts")}
          >기록 살펴보기 <span aria-hidden="true">↗</span></a
        >
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="visual-top">
          <span>THE ENGINEERING LOOP</span><span>↗</span>
        </div>
        <div class="loop">
          <div class="loop-item">
            <span>01</span><b>질문하다</b><small>Ask the right question.</small>
          </div><span class="loop-connector">↓</span><div
            class="loop-item loop-active"
          >
            <span>02</span><b>만들어보다</b><small
              >Make it. Understand it.</small>
          </div><span class="loop-connector">↓</span><div class="loop-item">
            <span>03</span><b>기록하고 나누다</b><small
              >Leave a useful note.</small>
          </div>
        </div>
        <div class="visual-bottom">
          <span class="status-dot"></span> ALWAYS A WORK IN PROGRESS <span
            >↺</span>
        </div>
      </div>
    </section>
    <div class="topic-bar">
      <span class="eyebrow">EXPLORE</span><a
        class="topic-all"
        href={getRelativeLocaleUrl(locale, "posts")}
        >모든 기록 <span>{posts.length}</span></a
      >{
        tags
          .slice(0, 5)
          .map(({ tag, tagName }) => (
            <a href={getRelativeLocaleUrl(locale, `tags/${tag}`)}>{tagName}</a>
          ))
      }
    </div>
    {
      featured && (
        <section class="home-section">
          <>
            <div class="section-heading">
              <>
                <div>
                  <>
                    <span class="eyebrow">FEATURED</span>
                    <h2>먼저 읽어보세요</h2>
                  </>
                </div>
                <span class="section-note">지금, 함께 나누고 싶은 이야기</span>
              </>
            </div>
            <ul class="featured-list">
              <Card variant="h3" featured {...featured} />
            </ul>
          </>
        </section>
      )
    }
    <section class="home-section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">LATEST NOTES</span><h2>최근의 기록</h2>
        </div><a class="text-link" href={getRelativeLocaleUrl(locale, "posts")}
          >전체 보기 <span aria-hidden="true">→</span></a>
      </div><ul class="post-grid">
        {
          recent
            .slice(0, config.posts.perIndex)
            .map(post => <Card variant="h3" {...post} />)
        }
      </ul>
    </section>
    <section class="closing-note">
      <span class="eyebrow">LEARN IN PUBLIC</span><p>
        완벽한 답보다, 더 나은 질문을 쌓아갑니다.
      </p><a class="text-link" href={getRelativeLocaleUrl(locale, "about")}
        >PSL Tech 소개 <span aria-hidden="true">→</span></a>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector<HTMLElement>("[data-home-path]");
    if (main?.dataset.homePath)
      sessionStorage.setItem("backUrl", main.dataset.homePath);
  });
</script>
