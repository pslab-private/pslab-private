---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import config from "@/config";
const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts"));
const featured = posts.find(post => post.data.featured);
const recent = posts.filter(post => post.id !== featured?.id);
const tags = getUniqueTags(posts);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    class="app-layout home-main"
    data-layout="index"
    data-home-path={homePath}
  >
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">
          <span class="status-dot" aria-hidden="true"></span> PHYSICS SIM LAB · TECH
          BLOG
        </p>
        <h1 id="hero-title">로봇이 배울 세계를 만듭니다.</h1>
        <p class="hero-description">
          물리 기반 시뮬레이션과 합성 데이터로<br class="hidden sm:block" /> Physical
          AI의 학습 인프라를 구축합니다.
        </p>
      </div>
      <div class="company-summary">
        <span class="eyebrow">SIMULATION · ROBOTICS · PHYSICAL AI</span>
        <p>
          정확한 물리, 로봇 제어, 검증 가능한 데이터.<br />구현 과정에서 얻은
          지식과 실험을 공유합니다.
        </p>
        <a class="text-link" href="https://pslab.ai/"
          >회사 홈페이지 <span aria-hidden="true">↗</span></a
        >
      </div>
    </section>
    <div class="topic-bar">
      <span class="eyebrow">EXPLORE</span><a
        class="topic-all"
        href={getRelativeLocaleUrl(locale, "posts")}
        >모든 기록 <span>{posts.length}</span></a
      >{
        tags
          .slice(0, 5)
          .map(({ tag, tagName }) => (
            <a href={getRelativeLocaleUrl(locale, `tags/${tag}`)}>{tagName}</a>
          ))
      }
    </div>
    {
      featured && (
        <section class="home-section">
          <>
            <div class="section-heading">
              <>
                <div>
                  <>
                    <span class="eyebrow">FEATURED</span>
                    <h2>기술 아티클</h2>
                  </>
                </div>
                <span class="section-note">
                  구현부터 검증까지, 현장에서 쌓은 기록
                </span>
              </>
            </div>
            <ul class="featured-list">
              <Card variant="h3" featured {...featured} />
            </ul>
          </>
        </section>
      )
    }
    {
      recent.length > 0 && (
        <section class="home-section">
          <>
            <div class="section-heading">
              <>
                <div>
                  <>
                    <span class="eyebrow">LATEST NOTES</span>
                    <h2>최근의 기록</h2>
                  </>
                </div>
                <a
                  class="text-link"
                  href={getRelativeLocaleUrl(locale, "posts")}
                >
                  전체 보기 <span aria-hidden="true">→</span>
                </a>
              </>
            </div>
            <ul class="post-grid">
              {recent.slice(0, config.posts.perIndex).map(post => (
                <Card variant="h3" {...post} />
              ))}
            </ul>
          </>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector<HTMLElement>("[data-home-path]");
    if (main?.dataset.homePath)
      sessionStorage.setItem("backUrl", main.dataset.homePath);
  });
</script>
