---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
const { class: className, noMarginTop = false, ...attrs } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<footer
  class:list={[
    "app-layout site-footer",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div>
    <a class="footer-brand" href={getRelativeLocaleUrl(locale, "")}
      >PSL Tech<span class="status-dot" aria-hidden="true"></span></a
    ><p>배우고, 만들고, 기록합니다.</p>
  </div>
  <div class="footer-links">
    <a href={getAssetPath("rss.xml")}>RSS</a><a
      href={getRelativeLocaleUrl(locale, "archives")}>아카이브</a
    ><a href="https://github.com/pslab-private/pslab-private.github.io"
      >GitHub ↗</a
    ><span>© {new Date().getFullYear()} PSL Tech</span>
  </div>
</footer>
