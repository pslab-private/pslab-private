{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",
  "frontMatter.content.publicFolder": "public",
  "frontMatter.content.pageFolders": [
    { "title": "기술 글", "path": "[[workspace]]/src/content/posts" }
  ],
  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "default",
      "pageBundle": false,
      "fields": [
        { "title": "제목", "name": "title", "type": "string", "single": true },
        { "title": "요약", "name": "description", "type": "string" },
        {
          "title": "대표 이미지 (한 장 직접 지정)",
          "name": "coverImage",
          "type": "image",
          "multiple": false,
          "isPreviewImage": true,
          "description": "글의 핵심을 보여주는 이미지 한 장을 작성자가 선택합니다. 이미지가 없는 글만 비워둡니다."
        },
        {
          "title": "발행일",
          "name": "pubDatetime",
          "type": "datetime",
          "default": "{{now}}",
          "isPublishDate": true
        },
        {
          "title": "수정일",
          "name": "modDatetime",
          "type": "datetime",
          "isModifiedDate": true
        },
        { "title": "태그", "name": "tags", "type": "tags" },
        { "title": "초안", "name": "draft", "type": "boolean", "default": true }
      ]
    }
  ],
  "frontMatter.preview.host": "http://localhost:4321",
  "frontMatter.preview.pathName": "/posts/{{pathToken.relPath}}/",
  "frontMatter.preview.trailingSlash": true
}
